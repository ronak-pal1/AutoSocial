PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/autosocial

JWT_ACCESS_SECRET=autosocial_super_secret_access_jwt_key_32charsmin!
JWT_REFRESH_SECRET=autosocial_super_secret_refresh_jwt_key_32charsmin!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Storage directory for generated images and failure screenshots
STORAGE_DIR=./storage

# Optional Chromium executable path on Mac / Linux (e.g. /Applications/Google Chrome.app/Contents/MacOS/Google Chrome)
CHROME_EXECUTABLE_PATH=
CHROME_REMOTE_DEBUGGING_PORT=

# Seed defaults
DEFAULT_ADMIN_EMAIL=admin@autosocial.io
DEFAULT_ADMIN_PASSWORD=AdminSecurePassword123!
